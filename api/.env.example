# Bootstrap configuration.
#
# The API requires SUPABASE_JWT_ISSUER to start so it can configure Supabase
# access-token verification. The audience defaults to authenticated.
PORT=8080

# Private server-only configuration. Never expose these values to Expo or
# commit a populated .env file.
DATABASE_URL=postgresql://postgres:<database-password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SECRET_KEY=sb_secret_replace-with-server-only-key
